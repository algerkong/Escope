{
  "name": "escope",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:prototype": "node scripts/build.mjs",
    "test:prototype": "node --test tests/platform.test.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests/unit tests/browser",
    "check": "npm run lint && npm run build && npm test && npm run build:prototype && npm run test:prototype",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ai:gateway": "node scripts/test-ai-gateway.mjs",
    "build:desktop": "tauri build --no-bundle",
    "build:installer:windows": "tauri build --bundles nsis --config src-tauri/tauri.windows.conf.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-table": "^9.2.6",
    "@tauri-apps/api": "^2.9.1",
    "i18next": "^25.6.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher@2.5.1": "2.5.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.9.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "lucide": "0.468.0",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.11"
  }
}
