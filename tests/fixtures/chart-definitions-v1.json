{
  "version": 1,
  "entries": [
    {
      "id": "chart-latency-by-day",
      "name": "Latency per day",
      "connectionId": "11111111-1111-4111-8111-111111111111",
      "index": "logs-*",
      "draft": {
        "group": {
          "type": "date_histogram",
          "name": "per_day",
          "field": "@timestamp",
          "interval": "fixed_interval",
          "intervalValue": "30d",
          "timeZone": "UTC"
        },
        "metrics": [
          { "name": "total", "type": "sum", "field": "bytes" },
          { "name": "slowest", "type": "max", "field": "latency" },
          { "name": "hosts", "type": "cardinality", "field": "host" }
        ]
      },
      "measure": "total"
    },
    {
      "id": "chart-top-hosts",
      "name": "Top hosts",
      "connectionId": "22222222-2222-4222-8222-222222222222",
      "index": "events",
      "draft": {
        "group": {
          "type": "terms",
          "name": "by_host",
          "field": "host",
          "size": "20"
        },
        "metrics": []
      },
      "measure": "doc_count"
    },
    {
      "id": "chart-single-average",
      "name": "Average latency",
      "connectionId": "33333333-3333-4333-8333-333333333333",
      "index": "metrics-*",
      "draft": {
        "group": null,
        "metrics": [{ "name": "average", "type": "avg", "field": "latency" }]
      },
      "measure": "average"
    }
  ]
}
