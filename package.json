{
  "name": "escope",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:prototype": "node scripts/build.mjs",
    "test:prototype": "node --test tests/platform.test.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests/unit",
    "check": "npm run lint && npm run build && npm test && npm run build:prototype && npm run test:prototype",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:desktop": "tauri build --no-bundle"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tauri-apps/api": "^2.9.1",
    "i18next": "^25.6.0",
    "lucide-react": "0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tailwindcss/cli": "^4.1.0",
    "@tauri-apps/cli": "^2.9.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.11",
    "tailwindcss": "^4.1.0",
    "lucide": "0.468.0",
    "jsdom": "^26.0.0"
  }
}
